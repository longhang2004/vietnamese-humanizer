    {
      "id": "grammar-checker-vi",
      "title": "Soát lỗi tiếng Việt",
      "summary": "Kiểm tra chính tả, dấu câu, cấu trúc câu và những chỗ còn mơ hồ.",
      "description": "Kiểm tra chính tả, dấu câu, cấu trúc câu và chỗ mơ hồ trong tiếng Việt. Dùng khi soát lỗi; giữ tên riêng, trích dẫn và cách dùng từ vùng miền phù hợp.",
      "request": "Soát chính tả, dấu câu và cấu trúc trong đoạn dưới đây. Chỉ sửa lỗi có căn cứ. Giữ cách diễn đạt đúng và cách dùng từ vùng miền phù hợp.",
      "skill_version": "0.2.1"
    },
    {
      "id": "style-guide-vi",
      "title": "Giữ cách viết nhất quán",
      "summary": "Rà xưng hô, thuật ngữ và cách trình bày, từ viết hoa đến số và ngày giờ.",
      "description": "Thống nhất cách xưng hô, thuật ngữ, viết hoa, số, ngày giờ, đơn vị và định dạng. Dùng khi rà cách viết; ưu tiên quy ước và bảng thuật ngữ bạn cung cấp.",
      "request": "Kiểm tra xem cách xưng hô, thuật ngữ, viết hoa, số, ngày giờ và định dạng có nhất quán không. Theo quy ước tôi cung cấp. Hỏi lại nếu lựa chọn có thể làm đổi nghĩa.",
      "skill_version": "0.2.1"
    }
