{
  "name": "vietnamese-writing-skills-frontend",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "npm run format:check && eslint . && npm run ui:check",
    "test": "vitest run",
    "format": "prettier --write app components lib \"*.config.{js,ts,mjs}\"",
    "format:check": "prettier --check app components lib \"*.config.{js,ts,mjs}\"",
    "ui:check": "impeccable detect --github app components"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "^16.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.1",
    "impeccable": "4.8.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.39",
    "prettier": "3.9.10",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vitest": "^4.1.12"
  }
}
